{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contextual Engine private labelled feasibility corpus",
  "type": "object",
  "required": ["schema_version", "samples"],
  "properties": {
    "schema_version": {"const": 1},
    "samples": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "audio_path", "language", "content_types", "taxonomy_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "audio_path": {"type": "string", "minLength": 1, "description": "Owner-local normalized WAV; never commit private media."},
          "language": {"enum": ["en", "zh", "ja", "none"]},
          "content_types": {"type": "array", "minItems": 1, "items": {"enum": ["speech", "vocal_music", "speech_sparse_music", "instrumental_music"]}},
          "taxonomy_ids": {"type": "array", "items": {"type": "string"}, "description": "Ground-truth category labels only."},
          "is_music": {"type": "boolean"},
          "vocal_presence": {"enum": ["vocal", "instrumental", "mixed", "unknown"]},
          "genres": {"type": "array", "items": {"type": "string"}},
          "moods": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
